<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>सेवा साथी - Seva Saathi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Poppins', sans-serif; }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 pb-20">

    <!-- Top Header -->
    <header class="bg-blue-600 text-white p-4 shadow-md sticky top-0 z-50 flex justify-between items-center">
        <div>
            <h1 class="text-xl font-bold flex items-center gap-2">
                <i class="fa-solid fa-hands-holding-child"></i> <span id="appTitle">सेवा साथी</span>
            </h1>
            <p class="text-xs text-blue-100" id="appSubTitle">मिस्त्री, मजदूर और मैकेनिक बुकिंग ऐप</p>
        </div>
        <div class="flex items-center gap-2">
            <select id="langSelect" onchange="changeLanguage(this.value)" class="bg-blue-700 text-white text-sm px-2 py-1 rounded border border-blue-400 outline-none">
                <option value="hi">🇮🇳 हिंदी</option>
                <option value="en">🇬🇧 English</option>
            </select>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto p-4">

        <!-- Navigation Tabs -->
        <div class="flex bg-white rounded-xl shadow-sm p-1 mb-4 border border-gray-100">
            <button onclick="switchTab('workers')" id="tabWorkers" class="flex-1 py-2 text-center text-sm font-semibold rounded-lg bg-blue-600 text-white transition">
                <i class="fa-solid fa-users"></i> <span id="lblTabWorkers">कारीगर</span>
            </button>
            <button onclick="switchTab('bookings')" id="tabBookings" class="flex-1 py-2 text-center text-sm font-semibold rounded-lg text-gray-600 transition">
                <i class="fa-solid fa-calendar-check"></i> <span id="lblTabBookings">बुकिंग्स</span>
            </button>
            <button onclick="switchTab('register')" id="tabRegister" class="flex-1 py-2 text-center text-sm font-semibold rounded-lg text-gray-600 transition">
                <i class="fa-solid fa-user-plus"></i> <span id="lblTabRegister">नया मिस्त्री</span>
            </button>
            <button onclick="switchTab('settings')" id="tabSettings" class="flex-1 py-2 text-center text-sm font-semibold rounded-lg text-gray-600 transition">
                <i class="fa-solid fa-mobile-screen"></i> <span id="lblTabSettings">APK गाइड</span>
            </button>
        </div>

        <!-- 1. Workers Section -->
        <div id="sectionWorkers" class="space-y-4">
            <!-- Category Filters -->
            <div class="flex gap-2 overflow-x-auto pb-2 scrollbar-none">
                <button onclick="filterCategory('All')" class="cat-btn bg-blue-600 text-white px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap shadow-sm" id="catAll">सभी</button>
                <button onclick="filterCategory('इलेक्ट्रीशियन')" class="cat-btn bg-white text-gray-700 border border-gray-200 px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap">⚡ इलेक्ट्रीशियन</button>
                <button onclick="filterCategory('प्लंबर')" class="cat-btn bg-white text-gray-700 border border-gray-200 px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap">🔧 प्लंबर</button>
                <button onclick="filterCategory('मजदूर')" class="cat-btn bg-white text-gray-700 border border-gray-200 px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap">🧱 मजदूर</button>
                <button onclick="filterCategory('बाइक मैकेनिक')" class="cat-btn bg-white text-gray-700 border border-gray-200 px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap">🏍️ बाइक मैकेनिक</button>
                <button onclick="filterCategory('कार मैकेनिक')" class="cat-btn bg-white text-gray-700 border border-gray-200 px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap">🚗 कार मैकेनिक</button>
            </div>

            <!-- Worker Cards List -->
            <div id="workersList" class="space-y-3">
                <!-- Dynamic Workers Rendered Here -->
            </div>
        </div>

        <!-- 2. Bookings Section -->
        <div id="sectionBookings" class="hidden space-y-4">
            <h2 class="text-lg font-bold text-gray-800" id="lblMyBookings">सक्रिय बुकिंग्स और कमीशन हिसाब</h2>
            <div id="bookingsList" class="space-y-3">
                <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 text-center text-gray-400 text-sm py-8" id="noBookingsText">
                    कोई बुकिंग नहीं है।
                </div>
            </div>
        </div>

        <!-- 3. Register Worker Section -->
        <div id="sectionRegister" class="hidden bg-white p-5 rounded-2xl shadow-sm border border-gray-100 space-y-4">
            <h2 class="text-lg font-bold text-gray-800" id="lblRegTitle">मिस्त्री / मैकेनिक रजिस्ट्रेशन</h2>
            <form id="workerForm" onsubmit="registerWorker(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1" id="lblRegName">पूरा नाम</label>
                    <input type="text" id="wName" required placeholder="जैसे: रमेश कुमार" class="w-full p-2.5 text-sm border rounded-xl outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1" id="lblRegCat">व्यवसाय चुनें</label>
                    <select id="wCategory" class="w-full p-2.5 text-sm border rounded-xl outline-none focus:border-blue-500 bg-white">
                        <option value="इलेक्ट्रीशियन">⚡ इलेक्ट्रीशियन (Electrician)</option>
                        <option value="प्लंबर">🔧 प्लंबर (Plumber)</option>
                        <option value="मजदूर">🧱 मजदूर / हेल्पर (Laborer)</option>
                        <option value="बाइक मैकेनिक">🏍️ बाइक मैकेनिक (Bike Mechanic)</option>
                        <option value="कार मैकेनिक">🚗 कार मैकेनिक (Car Mechanic)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1" id="lblRegPhone">मोबाइल नंबर</label>
                    <input type="tel" id="wPhone" required placeholder="9876543210" class="w-full p-2.5 text-sm border rounded-xl outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1" id="lblRegExp">अनुभव (वर्षों में)</label>
                    <input type="number" id="wExp" required placeholder="जैसे: 5 साल" class="w-full p-2.5 text-sm border rounded-xl outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1" id="lblRegRate">प्रतिदिन की दिहाड़ी / मजदूरी (₹)</label>
                    <input type="number" id="wRate" required placeholder="जैसे: 700" class="w-full p-2.5 text-sm border rounded-xl outline-none focus:border-blue-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1" id="lblRegStatus">उपलब्धता स्टेटस</label>
                    <select id="wStatus" class="w-full p-2.5 text-sm border rounded-xl outline-none focus:border-blue-500 bg-white">
                        <option value="उपलब्ध">🟢 उपलब्ध (Available)</option>
                        <option value="व्यस्त">🔴 व्यस्त / अनुपलब्ध (Busy / Not Available)</option>
                    </select>
                </div>
                <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-xl font-semibold text-sm shadow-md hover:bg-blue-700 transition" id="btnSubmitWorker">रजिस्टर करें</button>
            </form>
        </div>

        <!-- 4. APK / Settings Section -->
        <div id="sectionSettings" class="hidden bg-white p-5 rounded-2xl shadow-sm border border-gray-100 space-y-4">
            <h2 class="text-lg font-bold text-gray-800" id="lblApkTitle">📱 APK कैसे बनाएं?</h2>
            <p class="text-xs text-gray-600 leading-relaxed" id="lblApkDesc">
                इस ऐप को अपने फोन में असली एंड्रॉइड ऐप (.apk) के रूप में बदलने के लिए इन चरणों का पालन करें:
            </p>
            <ol class="list-decimal list-inside text-xs space-y-2 text-gray-700">
                <li>इस पूरे कोड को अपनी होस्टिंग (जैसे Vercel या GitHub Pages) पर अपलोड करें।</li>
                <li>मुफ्त टूल <a href="https://www.pwabuilder.com" target="_blank" class="text-blue-600 font-bold underline">PWABuilder.com</a> पर अपनी वेबसाइट का लिंक डालें।</li>
                <li>**"Generate APK"** पर क्लिक करें और कुछ ही सेकंड में अपनी ऐप की एपीके फाइल डाउनलोड करें!</li>
            </ol>
            <div class="bg-blue-50 p-3 rounded-xl border border-blue-100 text-xs text-blue-800">
                💡 **बिज़नेस टिप:** हर बुकिंग पर आपका तय प्लेटफॉर्म कमीशन (जैसे ₹50) सुरक्षित रूप से आपके पास आता है!
            </div>
        </div>

    </main>

    <!-- Booking Modal -->
    <div id="bookingModal" class="fixed inset-0 bg-black/50 hidden z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl w-full max-w-sm p-5 space-y-4 shadow-xl">
            <h3 class="text-base font-bold text-gray-800" id="modalTitle">कारीगर बुक करें</h3>
            <div id="modalWorkerInfo" class="text-xs text-gray-600 bg-gray-50 p-3 rounded-xl"></div>
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1" id="lblModalDays">काम के दिनों की संख्या (Days)</label>
                <input type="number" id="bookDays" value="1" min="1" oninput="calculateTotal()" class="w-full p-2 text-sm border rounded-xl outline-none">
            </div>
            <div class="bg-blue-50 p-3 rounded-xl border border-blue-100 text-xs space-y-1">
                <div class="flex justify-between"><span id="txtDailyRate">प्रतिदिन दिहाड़ी:</span> <span id="mRate" class="font-bold">₹0</span></div>
                <div class="flex justify-between"><span id="txtPlatformFee">प्लेटफॉर्म कमीशन (ओनर):</span> <span id="mCommission" class="font-bold text-green-600">₹50</span></div>
                <hr class="border-blue-200 my-1">
                <div class="flex justify-between font-bold text-gray-800"><span id="txtTotalCost">कुल अनुमानित खर्च:</span> <span id="mTotal">₹0</span></div>
            </div>
            <div class="flex gap-2">
                <button onclick="closeModal()" class="flex-1 bg-gray-100 text-gray-700 py-2.5 rounded-xl font-semibold text-xs" id="btnCancel">रद्द करें</button>
                <button onclick="confirmBooking()" class="flex-1 bg-blue-600 text-white py-2.5 rounded-xl font-semibold text-xs shadow-md" id="btnConfirm">⚡ 1-क्लिक बुक करें</button>
            </div>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        let currentLang = 'hi';
        let selectedWorker = null;

        const translations = {
            hi: {
                appTitle: "सेवा साथी",
                appSubTitle: "मिस्त्री, मजदूर और मैकेनिक बुकिंग ऐप",
                tabWorkers: "कारीगर",
                tabBookings: "बुकिंग्स",
                tabRegister: "नया मिस्त्री",
                tabSettings: "APK गाइड",
                catAll: "सभी",
                lblMyBookings: "सक्रिय बुकिंग्स और कमीशन हिसाब",
                noBookingsText: "कोई बुकिंग नहीं है।",
                lblRegTitle: "मिस्त्री / मैकेनिक रजिस्ट्रेशन",
                lblRegName: "पूरा नाम",
                lblRegCat: "व्यवसाय चुनें",
                lblRegPhone: "मोबाइल नंबर",
                lblRegExp: "अनुभव (वर्षों में)",
                lblRegRate: "प्रतिदिन की दिहाड़ी / मजदूरी (₹)",
                lblRegStatus: "उपलब्धता स्टेटस",
                btnSubmitWorker: "रजिस्टर करें",
                lblApkTitle: "📱 APK कैसे बनाएं?",
                lblApkDesc: "इस ऐप को अपने फोन में असली एंड्रॉइड ऐप (.apk) के रूप में बदलने के लिए इन चरणों का पालन करें:",
                modalTitle: "कारीगर बुक करें",
                lblModalDays: "काम के दिनों की संख्या (Days)",
                txtDailyRate: "प्रतिदिन दिहाड़ी:",
                txtPlatformFee: "प्लेटफॉर्म कमीशन (ओनर):",
                txtTotalCost: "कुल अनुमानित खर्च:",
                btnCancel: "रद्द करें",
                btnConfirm: "⚡ 1-क्लिक बुक करें",
                statusAvailable: "🟢 उपलब्ध",
                statusBusy: "🔴 व्यस्त / अनुपलब्ध",
                bookBtn: "⚡ 1-क्लिक बुक करें",
                busyBtn: "अनुपलब्ध (व्यस्त)",
                expText: "अनुभव",
                years: "साल"
            },
            en: {
                appTitle: "Seva Saathi",
                appSubTitle: "Worker & Mechanic Booking App",
                tabWorkers: "Workers",
                tabBookings: "Bookings",
                tabRegister: "Add Worker",
                tabSettings: "APK Guide",
                catAll: "All",
                lblMyBookings: "Active Bookings & Commission",
                noBookingsText: "No bookings found.",
                lblRegTitle: "Worker / Mechanic Registration",
                lblRegName: "Full Name",
                lblRegCat: "Select Profession",
                lblRegPhone: "Mobile Number",
                lblRegExp: "Experience (in Years)",
                lblRegRate: "Daily Wage / Rate (₹)",
                lblRegStatus: "Availability Status",
                btnSubmitWorker: "Register Worker",
                lblApkTitle: "📱 How to build APK?",
                lblApkDesc: "Follow these simple steps to turn this app into a real Android APK:",
                modalTitle: "Book Worker",
                lblModalDays: "Number of Working Days",
                txtDailyRate: "Daily Rate:",
                txtPlatformFee: "Platform Commission (Owner):",
                txtTotalCost: "Total Estimated Cost:",
                btnCancel: "Cancel",
                btnConfirm: "⚡ 1-Click Book",
                statusAvailable: "🟢 Available",
                statusBusy: "🔴 Busy / Not Available",
                bookBtn: "⚡ 1-Click Book",
                busyBtn: "Not Available",
                expText: "Exp",
                years: "years"
            }
        };

        let workers = [
            { id: 1, name: "रमेश कुमार", category: "इलेक्ट्रीशियन", phone: "9876543210", exp: "6", rate: 700, status: "उपलब्ध" },
            { id: 2, name: "सुरेश शर्मा", category: "प्लंबर", phone: "9123456789", exp: "8", rate: 800, status: "उपलब्ध" },
            { id: 3, name: "मोहन लाल", category: "मजदूर", phone: "9988776655", exp: "4", rate: 500, status: "व्यस्त" },
            { id: 4, name: "विकास सिंह", category: "बाइक मैकेनिक", phone: "9811223344", exp: "7", rate: 750, status: "उपलब्ध" },
            { id: 5, name: "अमित वर्मा", category: "कार मैकेनिक", phone: "9755443322", exp: "10", rate: 1200, status: "उपलब्ध" }
        ];

        let bookings = [];

        function changeLanguage(lang) {
            currentLang = lang;
            const t = translations[lang];
            document.getElementById('appTitle').innerText = t.appTitle;
            document.getElementById('appSubTitle').innerText = t.appSubTitle;
            document.getElementById('lblTabWorkers').innerText = t.tabWorkers;
            document.getElementById('lblTabBookings').innerText = t.tabBookings;
            document.getElementById('lblTabRegister').innerText = t.tabRegister;
            document.getElementById('lblTabSettings').innerText = t.tabSettings;
            document.getElementById('catAll').innerText = t.catAll;
            document.getElementById('lblMyBookings').innerText = t.lblMyBookings;
            document.getElementById('noBookingsText').innerText = t.noBookingsText;
            document.getElementById('lblRegTitle').innerText = t.lblRegTitle;
            document.getElementById('lblRegName').innerText = t.lblRegName;
            document.getElementById('lblRegCat').innerText = t.lblRegCat;
            document.getElementById('lblRegPhone').innerText = t.lblRegPhone;
            document.getElementById('lblRegExp').innerText = t.lblRegExp;
            document.getElementById('lblRegRate').innerText = t.lblRegRate;
            document.getElementById('lblRegStatus').innerText = t.lblRegStatus;
            document.getElementById('btnSubmitWorker').innerText = t.btnSubmitWorker;
            document.getElementById('lblApkTitle').innerText = t.lblApkTitle;
            document.getElementById('lblApkDesc').innerText = t.lblApkDesc;
            document.getElementById('modalTitle').innerText = t.modalTitle;
            document.getElementById('lblModalDays').innerText = t.lblModalDays;
            document.getElementById('txtDailyRate').innerText = t.txtDailyRate;
            document.getElementById('txtPlatformFee').innerText = t.txtPlatformFee;
            document.getElementById('txtTotalCost').innerText = t.txtTotalCost;
            document.getElementById('btnCancel').innerText = t.btnCancel;
            document.getElementById('btnConfirm').innerText = t.btnConfirm;
            renderWorkers('All');
            renderBookings();
        }

        function switchTab(tab) {
            ['Workers', 'Bookings', 'Register', 'Settings'].forEach(t => {
                document.getElementById('section' + t).classList.add('hidden');
                document.getElementById('tab' + t).className = "flex-1 py-2 text-center text-sm font-semibold rounded-lg text-gray-600 transition";
            });
            document.getElementById('section' + tab).classList.remove('hidden');
            document.getElementById('tab' + tab).className = "flex-1 py-2 text-center text-sm font-semibold rounded-lg bg-blue-600 text-white transition";
        }

        function renderWorkers(cat) {
            const list = document.getElementById('workersList');
            list.innerHTML = "";
            const t = translations[currentLang];

            const filtered = cat === 'All' ? workers : workers.filter(w => w.category === cat);

            if (filtered.length === 0) {
                list.innerHTML = `<div class="bg-white p-6 rounded-xl text-center text-gray-400 text-sm">कोई कारीगर उपलब्ध नहीं है।</div>`;
                return;
            }

            filtered.forEach(w => {
                const isBusy = w.status === 'व्यस्त';
                const statusBadge = isBusy 
                    ? `<span class="bg-red-100 text-red-600 text-xs px-2 py-0.5 rounded-full font-medium">${t.statusBusy}</span>`
                    : `<span class="bg-green-100 text-green-700 text-xs px-2 py-0.5 rounded-full font-medium">${t.statusAvailable}</span>`;

                const actionBtn = isBusy 
                    ? `<button disabled class="bg-gray-200 text-gray-400 px-3 py-1.5 rounded-xl text-xs font-semibold cursor-not-allowed">${t.busyBtn}</button>`
                    : `<button onclick="openBookingModal(${w.id})" class="bg-blue-600 text-white px-3 py-1.5 rounded-xl text-xs font-semibold shadow hover:bg-blue-700 transition">${t.bookBtn}</button>`;

                list.innerHTML += `
                    <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex justify-between items-center">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <h3 class="font-bold text-gray-800 text-sm">${w.name}</h3>
                                ${statusBadge}
                            </div>
                            <p class="text-xs text-gray-500 font-medium">${w.category} • ${t.expText}: ${w.exp} ${t.years}</p>
                            <p
